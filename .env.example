# HTTP listener
NODEX_BIND_ADDR=0.0.0.0:8081
RUST_LOG=info,nodex_token_data=debug

# Required frontend-to-backend API key (minimum 32 characters).
# Generate a random secret and store it in deployment secrets, never Git.
NODEX_API_KEY=

# Helius primary: comma-separated API keys.
HELIUS_API_KEYS=
HELIUS_RPC_URL_TEMPLATE=https://mainnet.helius-rpc.com/?api-key={api_key}

# FluxRPC fallback: comma-separated API keys and URL template.
FLUXRPC_API_KEYS=
FLUXRPC_RPC_URL_TEMPLATE=
