# HTTP listener
NODEX_BIND_ADDR=0.0.0.0:8081
RUST_LOG=info,nodex_token_data=debug

# Helius: comma-separated API keys. The default URL template is suitable
# for Solana mainnet. Keep real keys out of Git.
HELIUS_API_KEYS=
HELIUS_RPC_URL_TEMPLATE=https://mainnet.helius-rpc.com/?api-key={api_key}

# FluxRPC: comma-separated API keys and the provider's RPC URL template.
# The template must contain the literal {api_key} placeholder.
FLUXRPC_API_KEYS=
FLUXRPC_RPC_URL_TEMPLATE=
